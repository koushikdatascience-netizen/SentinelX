SENTINELX_MODE=demo
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
MAX_LIVE_REQUESTS_PER_SESSION=5
DATABASE_URL=postgresql+psycopg://sentinelx:change-me@localhost:5432/sentinelx
