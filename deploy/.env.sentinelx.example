# Populate only on Oracle server. chmod 600 .env.sentinelx
SENTINELX_POSTGRES_PASSWORD=replace-with-unique-strong-password
SENTINELX_JWT_SECRET=replace-with-64-character-random-secret
SENTINELX_PUBLIC_ORIGIN=https://sentinelx.kamalwoodcraft.in
# Comma-separated operator-approved test email addresses; empty disables all signup.
SENTINELX_REGISTRATION_ALLOWED_EMAILS=
