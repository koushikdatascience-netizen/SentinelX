# Hostinger SentinelX values only. Copy to /srv/sentinelx/source/.env.sentinelx and chmod 600.
# Generate unique values; do not reuse another application's credentials.
SENTINELX_POSTGRES_PASSWORD=replace-with-a-unique-url-safe-password
SENTINELX_JWT_SECRET=replace-with-at-least-64-random-characters
SENTINELX_PUBLIC_ORIGIN=https://sentinelx.kamalwoodcraft.in
SENTINELX_REGISTRATION_ALLOWED_EMAILS=
